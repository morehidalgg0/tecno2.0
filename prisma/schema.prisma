// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sucursal {
  id      String   @id @default(cuid())
  nombre  String
  ciudad  String
  stocks  Stock[]
  ordenes Orden[]
}

model Producto {
  id        String   @id @default(cuid())
  nombre    String
  marca     String
  categoria String
  precio    Float
  imagenUrl String
  specs     Json     // e.g. {"pantalla": "6.1", "memoria": "128GB"}
  codigoInterno String?
  activo    Boolean  @default(true)
  stocks    Stock[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stock {
  productoId String
  sucursalId String
  cantidad   Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([productoId, sucursalId])
}

model Cliente {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  telefono     String?
  createdAt    DateTime @default(now())
  ordenes      Orden[]
}

model Orden {
  id              String    @id @default(cuid())
  productos       Json      // e.g. [{"id": "...", "nombre": "...", "precio": 100, "cantidad": 2}]
  monto           Float
  descuento       Float     @default(0)
  costoEnvio      Float     @default(0)
  tipoEnvio       String    @default("RETIRO") // RETIRO o ENVIO
  domicilio       String?
  codigoPostal    String?
  telefono        String?
  estado          String    @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO, ENVIADO, DESPACHADO
  mercadoPagoId   String?   @unique
  cuponCode       String?
  clienteEmail    String?
  clienteNombre   String?
  sucursalId      String?
  sucursal        Sucursal? @relation(fields: [sucursalId], references: [id])
  clienteId       String?
  cliente         Cliente?  @relation(fields: [clienteId], references: [id])
  andreaniEnvioId String?
  etiquetaPdf     String?   // base64 PDF de la etiqueta Andreani
  trackingNumber  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Cupon {
  id             String   @id @default(cuid())
  codigo         String   @unique
  descuento      Float    // Porcentaje (ej: 10 = 10%)
  montoMinimo    Float    @default(0)
  activo         Boolean  @default(true)
  usoMaximo      Int?
  usoActual      Int      @default(0)
  validoDesde    DateTime?
  validoHasta    DateTime?
  createdAt      DateTime @default(now())
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
