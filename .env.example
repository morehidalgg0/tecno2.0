# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/tecnoguemes?schema=public"

# JWT - Generar un secret largo y aleatorio
JWT_SECRET="cambia-esto-por-un-secret-largo-y-aleatorio-minimo-32-caracteres"

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-tu-token-aqui"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (email transaccional) - Opcional, si no se configura no envía emails
RESEND_API_KEY="re_tu-api-key-aqui"
EMAIL_FROM="Tecno Güemes <notificaciones@tecnoguemes.com>"
