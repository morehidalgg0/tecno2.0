# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/tecnoguemes?schema=public"

# JWT - Generar un secret largo y aleatorio
JWT_SECRET="cambia-esto-por-un-secret-largo-y-aleatorio-minimo-32-caracteres"

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-tu-token-aqui"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Costo de envío fijo (cuando Andreani no está configurado)
NEXT_PUBLIC_ENVIO_FIJO=5000

# Resend (email transaccional) - Opcional, si no se configura no envía emails
RESEND_API_KEY="re_tu-api-key-aqui"
EMAIL_FROM="Tecno Güemes <notificaciones@tecnoguemes.com>"

# Andreani (envíos) - Opcional, si no se configura usa precio fijo
ANDREANI_API_URL="https://api.andreani.com/v1"
ANDREANI_CONTRATO="tu-numero-de-contrato"
ANDREANI_USER="tu-usuario"
ANDREANI_PASS="tu-password"

# Datos del origen de envío (sucursal principal)
CP_ORIGEN="7600"
DIRECCION_ORIGEN="Av. Independencia 1234"
LOCALIDAD_ORIGEN="Mar del Plata"
PROVINCIA_ORIGEN="Buenos Aires"
